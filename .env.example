# === openAI-ChatBot Environment Configuration ===

# --- Provider Selection ---
CHATBOT_PROVIDER=openai         # openai | xai

# --- OpenAI ---
OPENAI_API_KEY=                 # required when CHATBOT_PROVIDER=openai

# --- xAI (Grok) ---
XAI_API_KEY=                    # required when CHATBOT_PROVIDER=xai

# --- Logging ---
LOG_FORMAT=color                # color | plain | json
LOG_LEVEL=INFO
